# China Energy Market Monitor — secrets template
# Copy to .env and fill in values. The real .env is gitignored.

# Telegram — token from @BotFather, chat ID from @userinfobot
# Multiple chat IDs are comma-separated: 123456,−987654
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Reddit API — optional, only needed if reddit.enabled: true in config.yaml
# Get credentials at https://www.reddit.com/prefs/apps (free, script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=china-monitor/0.1 by u/yourname

# Logging
LOG_LEVEL=INFO
