# Secrets for running locally or on the NAS. Copy to .env (gitignored).
# In GitHub Actions the same values are repository secrets.

# Telegram — token from @BotFather; chat IDs comma-separated (personal and/or group).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude subscription token for headless Claude Code — create with:  claude setup-token
# Without it everything still runs, but messages are facts only (no analysis).
CLAUDE_CODE_OAUTH_TOKEN=

# Optional
# MONITOR_CLAUDE_MODEL=claude-sonnet-5-5
# LOG_LEVEL=INFO
