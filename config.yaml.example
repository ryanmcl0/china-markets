# China energy watchlist monitor — configuration template.
#
# Copy to config.yaml (gitignored) and edit. For GitHub Actions, upload it as
# the MONITOR_CONFIG secret:   gh secret set MONITOR_CONFIG < config.yaml
# On the NAS it's bind-mounted into the container.

watchlist:
  # exchange: XSHE = Shenzhen | XSHG = Shanghai | HKEX = Hong Kong
  # short_en: up to 9 characters, used in the phone-width scoreboard.
  # short_zh: the exchange short name (证券简称) — news search keys on it,
  #           so it must match how Chinese media write the name.
  # filings_code: A-share code for exchange filings. Defaults to the ticker
  #           for A-shares; set it for H-shares that also list in China.
  # gtc_limit: your buy limit, in the listing currency. /limit in Telegram
  #           overrides it without editing this file.
  # tags: include one of core / speculative (default tier is satellite).

  - ticker: "002255"
    name_en: "Suzhou Hailu Heavy Industry"
    short_en: "Hailu"
    short_zh: "海陆重工"
    exchange: "XSHE"
    currency: "CNY"
    gtc_limit: 10.50
    status: "watching"          # watching / holding / exited
    thesis: >
      Confirmed TMSR-LF1 safety heat exchanger contract — direct thorium
      supply-chain exposure ahead of the 10MW demo (2029) and 100MW (2035).
    tags: [thorium, nuclear, core]

  - ticker: "03750"
    name_en: "CATL (H)"
    short_en: "CATL-H"
    short_zh: "宁德时代"
    exchange: "HKEX"
    currency: "HKD"
    filings_code: "300750"      # CATL's Shenzhen listing files the announcements
    gtc_limit: 628.00
    status: "watching"
    thesis: >
      World's largest battery maker; long-run growth in grid storage.
    tags: [battery, storage, core]

  - ticker: "600111"
    name_en: "China Northern Rare Earth"
    short_en: "N.RareEar"
    short_zh: "北方稀土"
    exchange: "XSHG"
    currency: "CNY"
    gtc_limit: 44.00
    status: "watching"
    thesis: >
      Operator of Bayan Obo — rare earths plus China's thorium tailings.
    tags: [rare-earth, thorium]

# Theme news for the weekly brief. A headline must contain one of the
# title_terms to count — that's what keeps unrelated stories out.
themes:
  - name: "Thorium / molten salt reactors"
    queries: ["钍基熔盐堆", "熔盐堆", "钍"]
    title_terms: ["钍", "熔盐", "TMSR"]
  - name: "China nuclear build-out"
    queries: ["核电机组", "核电 核准"]
    title_terms: ["核电", "核能", "核岛"]

# Who the messages are written for. Injected into every Claude prompt.
investor:
  type: "long-term retail investor"
  country: "UK"
  horizon: "5-10 years"
  bias: "buy dips, do not chase spikes"
  risk_tolerance: "medium-high"
  notes: >
    Interested in thesis-confirming news above all else. Prefers to enter
    on weakness rather than momentum. Short-term volatility is irrelevant.

investing_rules:
  - "Never chase a stock that has risen >15% in a single session"
  - "Only add to a position if the thesis is confirmed — not just price moving"
  - "Macro noise (US tariffs, property sector, geopolitics) is not a reason to sell thesis stocks"
  - "For speculative positions require a higher evidence bar before adding"
